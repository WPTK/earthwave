Screen {
    background: $surface;
}

* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $primary-darken-2;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

#ticker {
    height: 1;
    background: $panel;
}

#main {
    height: 1fr;
}

#left {
    width: 1fr;
}

#header {
    height: 1;
}

#quakes {
    height: 1fr;
    overflow-x: hidden;
}

#empty {
    display: none;
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

#right {
    width: 45%;
}

#map {
    height: 1fr;
    border: round $primary-darken-2;
}

#map:focus {
    border: round $primary;
}

#tsunami {
    height: auto;
    max-height: 12;
    min-height: 4;
    border: round $primary-darken-2;
    padding: 0 1;
}

#tsunami.pulse {
    border: round red;
}

#banner {
    display: none;
    height: 1;
    background: #b91c1c;
    color: white;
}

#status.alert-info {
    background: #1e3a8a;
}

#status.alert-active {
    background: #7c2d12;
}

#status.alert-alarm {
    background: #b91c1c;
}

TsunamiScreen {
    layout: vertical;
}

#tsunami_body {
    height: 1fr;
    padding: 0 1;
}

#alert_table {
    height: 40%;
}

#alert_text_scroll {
    height: 1fr;
    min-height: 3;  /* the bulletin keeps some rows however many gauges are shown */
    border-top: solid $primary-darken-2;
    padding: 0 1;
}

#gauges {
    height: auto;
    max-height: 40%;  /* more rows than this scroll instead of squeezing out the bulletin or falling off the bottom */
}

#search {
    display: none;
    height: 3;
    dock: bottom;
    margin-bottom: 2;  /* above the status bar and the footer */
}

#status {
    height: 1;
    dock: bottom;
    margin-bottom: 1;  /* the footer takes the last row */
    background: $panel;
}

#too_small {
    display: none;
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    background: $error-darken-2;
    layer: overlay;
}

Screen.too-small #too_small {
    display: block;
}

Screen.too-small #banner,
Screen.too-small #main,
Screen.too-small #ticker,
Screen.too-small #status,
Screen.too-small Footer,
Screen.too-small #search {
    display: none;
}

Screen.no-map #map {
    display: none;
}

/* Narrow: the map is gone (no-map) but the tsunami panel stays, as a strip under the list, so a state that has no
   other text here (UNKNOWN, an acknowledged alert) is still readable. */
Screen.narrow #main {
    layout: vertical;
}

Screen.narrow #left {
    height: 1fr;
}

Screen.narrow #right {
    width: 100%;
    height: auto;
}

/* Full-screen map: hide the list and the tsunami panel. These come after the narrow and no-map rules at the same
   specificity, so the map shows even in a terminal narrower than the auto-hide width. */
Screen.map-full #left,
Screen.map-full #tsunami {
    display: none;
}

Screen.map-full #right {
    display: block;
    width: 1fr;
    height: 1fr;
}

Screen.map-full #map {
    display: block;
}

FiltersScreen, HelpScreen {
    align: center middle;
}

#dialog {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#dialog_title {
    text-style: bold;
    margin-bottom: 1;
}

#error {
    color: $error;
    width: 100%;
    height: auto;
    min-height: 1;
}

#buttons {
    height: 3;
    margin-top: 1;
}

#buttons Button {
    margin-right: 2;
}

#help_box {
    width: 80;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#detail_scroll {
    padding: 1 2;
}

Footer {
    scrollbar-size-horizontal: 0;  /* too long for the width: later (lower priority) keys are cut off, no scrollbar row */
}
