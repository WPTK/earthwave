Screen {
    background: $surface;
}

#ticker {
    height: 1;
    background: $panel;
}

#main {
    height: 1fr;
}

#left {
    width: 1fr;
}

#header {
    height: 1;
}

#quakes {
    height: 1fr;
}

#map {
    width: 45%;
    border: round $primary-darken-2;
    content-align: center middle;
    color: $text-muted;
}

#search {
    display: none;
    height: 3;
    dock: bottom;
    margin-bottom: 1;
}

#status {
    height: 1;
    dock: bottom;
    background: $panel;
}

#too_small {
    display: none;
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    background: $error-darken-2;
    layer: overlay;
}

Screen.too-small #too_small {
    display: block;
}

Screen.too-small #main,
Screen.too-small #ticker,
Screen.too-small #status,
Screen.too-small #search {
    display: none;
}

Screen.no-map #map {
    display: none;
}

FiltersScreen, HelpScreen {
    align: center middle;
}

#dialog {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#dialog_title {
    text-style: bold;
    margin-bottom: 1;
}

#error {
    color: $error;
    height: 1;
}

#buttons {
    height: 3;
    margin-top: 1;
}

#buttons Button {
    margin-right: 2;
}

#help_box {
    width: 80;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#detail_scroll {
    padding: 1 2;
}
