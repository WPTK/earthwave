Screen {
    background: $surface;
}

* {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $border;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
}

#ticker {
    height: 1;
    background: $surface;  /* $panel is 4.2:1 for the Warning red of a major quake's magnitude; the surface is 5.2:1 */
}

#main {
    height: 1fr;
}

#left {
    width: 1fr;
}

#header {
    height: 1;
}

#quakes {
    height: 1fr;
    overflow-x: hidden;
}

#empty {
    display: none;
    height: 1;
    color: $text-muted;
    padding: 0 1;
}

#right {
    width: 45%;
}

#map {
    height: 1fr;
    border: round $border;
}

#map:focus {
    border: round $primary;
}

#tsunami {
    border-title-color: $title;  /* the level border colours are grounds for white text; a title must read on the screen's own */
    height: auto;
    max-height: 12;
    min-height: 4;
    border: round $level-info-dim;  /* no actionable alert: an Information product */
    padding: 0 1;
}

/* Tsunami level colours come from earthwave/ui/theme.py (css_variables): Warning red, Advisory orange, Watch yellow,
   Threat blue, Information violet. They call for different actions; the level word is printed too, so the difference
   survives NO_COLOR. */
#tsunami.level-warning {
    border: round $level-warning-dim;
}

#tsunami.level-advisory {
    border: round $level-advisory-dim;
}

#tsunami.level-watch {
    border: round $level-watch-dim;
}

#tsunami.level-threat {
    border: round $level-threat-dim;
}

#tsunami.pulse.level-warning {
    border: round $level-warning;
}

#tsunami.pulse.level-advisory {
    border: round $level-advisory;
}

#tsunami.pulse.level-watch {
    border: round $level-watch;
}

#tsunami.pulse.level-threat {
    border: round $level-threat;
}

#banner {
    display: none;
    height: 1;
    background: $level-warning;
    color: black;
    text-style: bold;
}

#banner.level-advisory {
    background: $level-advisory;
}

#banner.level-watch {
    background: $level-watch;
}

#banner.level-threat {
    background: $level-threat;
}

#status.alert-info {
    background: $level-info-dim;
}

#status.level-warning {
    background: $level-warning-dim;
}

#status.level-advisory {
    background: $level-advisory-dim;
}

#status.level-watch {
    background: $level-watch-dim;
}

#status.level-threat {
    background: $level-threat-dim;
}

TsunamiScreen {
    layout: vertical;
}

#tsunami_body {
    height: 1fr;
    padding: 0 1;
}

#alert_table {
    height: auto;  /* sized to its rows: a screen with one or two alerts leaves the room to the bulletin and the gauges */
    max-height: 40%;
}

#alert_text_scroll {
    height: 1fr;
    min-height: 3;  /* the bulletin keeps some rows however many gauges are shown */
    border-top: solid $border;
    padding: 0 1;
}

#gauges {
    height: auto;
    max-height: 40%;  /* more rows than this scroll instead of squeezing out the bulletin or falling off the bottom */
    padding-bottom: 1;  /* the last row's residual bar is drawn a half-line low: a blank line keeps it off the footer */
}

#search {
    display: none;
    height: 3;
    dock: bottom;
    margin-bottom: 2;  /* above the status bar and the footer */
}

#status {
    height: 1;
    dock: bottom;
    margin-bottom: 1;  /* the footer takes the last row */
    background: $panel;
}

#too_small {
    display: none;
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    background: $surface;
    layer: overlay;
}

Screen.too-small #too_small {
    display: block;
}

Screen.too-small #banner,
Screen.too-small #main,
Screen.too-small #ticker,
Screen.too-small #status,
Screen.too-small Footer,
Screen.too-small #search,
Screen.too-small #history_head,
Screen.too-small #history_stats,
Screen.too-small #history_header,
Screen.too-small #history_list,
Screen.too-small #tsunami_body,
Screen.too-small #observations_body,
Screen.too-small #detail_scroll {
    display: none;
}

Screen.no-map #map {
    display: none;
}

/* No map (hidden with m, view.map = false, or a narrow terminal): the list takes the full width and the tsunami panel
   stays as a strip under it, so a state that has no other text here (UNKNOWN, an acknowledged alert) is still readable. */
Screen.no-map #main {
    layout: vertical;
}

Screen.no-map #left {
    height: 1fr;
}

Screen.no-map #right {
    width: 100%;
    height: auto;
}

/* Full-screen map: hide the list and the tsunami panel. These come after the narrow and no-map rules at the same
   specificity, so the map shows even in a terminal narrower than the auto-hide width. */
Screen.map-full #left,
Screen.map-full #tsunami {
    display: none;
}

Screen.map-full #right {
    display: block;
    width: 1fr;
    height: 1fr;
}

Screen.map-full #map {
    display: block;
}

FiltersScreen, HelpScreen {
    align: center middle;
}

#dialog {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#dialog_title {
    text-style: bold;
    margin-bottom: 1;
}

#error {
    color: $error;
    width: 100%;
    height: auto;
    min-height: 1;
}

#buttons {
    height: 3;
    margin-top: 1;
}

#buttons Button {
    margin-right: 2;
    border: none;  /* Textual's tinted button edges are 1.05:1 against the dialog; the label is the button */
    height: 3;
    content-align: center middle;
    background: $button;
    color: $bright;
}

#buttons Button.-primary {
    background: $button-primary;
}

/* focus must not rest on colour alone (issue #253): reverse video on the label as well */
#buttons Button:focus {
    text-style: bold reverse;
}

Input {
    border: tall $border;
}

Input:focus {
    border: heavy $bright;
}

#help_box {
    width: 80;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round $primary;
    background: $panel;
}

#detail_scroll {
    padding: 1 2;
}

Footer {
    scrollbar-size-horizontal: 0;  /* too long for the width: later (lower priority) keys are cut off, no scrollbar row */
}

/* The selected alert row takes the quake list's selection ground; Textual's default is a bright blue that no status
   colour reads on (3.8:1 for white). The bar glyph in the quake list marks the row too, so focus is not colour alone. */
DataTable > .datatable--cursor,
DataTable:focus > .datatable--cursor {
    background: $cursor;
    color: $bright;
    text-style: bold;
}
